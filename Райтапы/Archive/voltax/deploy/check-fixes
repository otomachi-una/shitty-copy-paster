#!/usr/bin/env ruby
# frozen_string_literal: true

require "open3"

ROOT = File.expand_path("..", __dir__)
PATCHES = Dir.glob(File.join(ROOT, "fixes/voltax/participant/*.patch")).sort.freeze

def usage
  puts "usage: ruby bin/check-fixes PARTICIPANT_TREE"
  puts "Runs git apply --check for all participant-targeted reference patches."
end

if ARGV == ["--help"] || ARGV == ["-h"]
  usage
  exit 0
end

participant_tree = ARGV[0]
abort "PARTICIPANT_TREE is required" if participant_tree.to_s.empty?
abort "participant tree not found: #{participant_tree}" unless Dir.exist?(participant_tree)
abort "no participant patches found" if PATCHES.empty?

failures = []
PATCHES.each do |patch|
  stdout, stderr, status = Open3.capture3("git", "apply", "--check", patch, chdir: participant_tree)
  if status.success?
    puts "PASS #{File.basename(patch)}"
  else
    failures << "#{File.basename(patch)}: #{stdout}#{stderr}"
  end
end
abort failures.join("\n") unless failures.empty?
puts "all participant fixes apply cleanly"
