      "direct database access" => /\b(?:psql|postgresql?:\/\/|DATABASE_URL|Sequel|ActiveRecord|sqlite3?|mysql)\b/i,
      "debug/admin route" => %r{/(?:api/)?(?:debug|admin|internal|__debug|fix|exploit)\b}i,
