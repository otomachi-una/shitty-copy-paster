def final_gets(stored)
  stored.each do |place, row|
    checker_get(place, row.fetch(:flag_id), row.fetch(:flag))
  end
  puts "PASS final owner GETs after retention horizon"
end

def assert_feed_sequences_monotonic(events)
  sequences = events.filter_map { |event| event["sequence"] if event.is_a?(Hash) }
  return if sequences == sequences.sort && sequences.uniq == sequences

  raise SoakFailure, "public feed sequences are not monotonic and unique in response"
end

def funded_user(label, account_profile: "spot")
  nonce = SecureRandom.hex(6)
  token = register_user(unique_username(label, nonce), account_profile)
  faucet(token, "#{label}-fund-#{nonce}") if account_profile == "spot"
  token
end

def unique_username(label, nonce)
  suffix = "-#{nonce}"
  budget = 32 - suffix.length
  base = label.to_s.gsub(/[^a-zA-Z0-9_.-]/, "-")[0, budget]
  base = "w18c" if base.length < 3
  "#{base}#{suffix}"
end

def register_user(username, account_profile)
  response = api_json(
    "POST",
    "/api/auth/register",
    payload: {
      username: username,
      password: "Vx-#{SecureRandom.urlsafe_base64(18)}",
      account_profile: account_profile
    }
  )
  token = response.dig("session", "token")
  raise SoakFailure, "registration failed" unless token.is_a?(String) && !token.empty?

  token
end

def faucet(token, idempotency_key)
  api_json("POST", "/api/faucet", token: token, payload: { idempotency_key: idempotency_key })
end

def create_order(token, side:, price:, quantity:, client_order_id:)
  api_json(
    "POST",
    "/api/orders",
    token: token,
    payload: {
      market_symbol: "VOLT-USDT",
      side: side,
      order_type: "limit",
      limit_price: price,
      quantity: quantity,
      client_order_id: client_order_id,
      execution_memo: "w18c-noise-order"
    }
  )
end

