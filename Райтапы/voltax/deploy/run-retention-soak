def ensure_docker_daemon!
  stdout, stderr, status = capture(["docker", "version", "--format", "{{.Server.Version}}"], timeout: 15)
  return stdout.strip if status.success? && !stdout.strip.empty?

  warn "BLOCKED_ENV docker daemon unavailable for live W18-C soak"
  warn redact([stdout, stderr].reject(&:empty?).join("\n"))[0, 4000]
  raise SoakFailure, "BLOCKED_ENV docker daemon unavailable"
end

def scoped_tree_fingerprint(root, relative_paths)
  files = relative_paths.flat_map do |relative|
    path = File.join(root, relative)
    if File.directory?(path)
      Find.find(path).filter_map do |entry|
        entry_relative = entry.delete_prefix(root).sub(%r{\A[\\/]}, "")
        parts = entry_relative.split(/[\\\/]/)
        if (parts & TREE_FINGERPRINT_EXCLUDES).any?
          Find.prune if File.directory?(entry)
          next
        end
        File.file?(entry) ? entry_relative.tr("\\", "/") : nil
      end
    elsif File.file?(path)
      relative.tr("\\", "/")
    end
  end.compact.sort

  digest = Digest::SHA256.new
  files.each do |relative|
    digest.update(relative)
    digest.update("\0")
    digest.update(File.binread(File.join(root, relative)))
    digest.update("\0")
  end
  [digest.hexdigest, files.length]
end

def ensure_competition_db_internal!
  stdout, = compose!("compose config no-db-port", "config")
  data = parse_compose_yaml(stdout)
  ports = data.dig("services", "postgres", "ports")
  raise SoakFailure, "competition profile publishes postgres ports" if ports && !ports.empty?

  puts "PASS competition profile keeps postgres internal"
end

def parse_compose_yaml(text)
  require "yaml"

  YAML.safe_load(text, permitted_classes: [], aliases: true) || {}
rescue StandardError => error
  raise SoakFailure, "compose config parse failed: #{error.message}"
end

def start_service
  compose!("compose cleanup #{PROJECT}", "down", "--remove-orphans", "-v", timeout: 120)
  ensure_competition_db_internal!
  compose!("compose build #{PROJECT}", "build", "exchange-api", "matching-engine", "market-simulator", timeout: 600)
  compose!("compose migrate #{PROJECT}", "run", "--rm", "exchange-api", "migrate", timeout: 180)
  compose!("compose migrate idempotent #{PROJECT}", "run", "--rm", "exchange-api", "migrate", timeout: 180)
  compose!("compose up #{PROJECT}", "up", "-d", timeout: 180)
  wait_ready
  health = fetch_json("#{HOST}/health")
  ready = fetch_json("#{HOST}/ready")
  raise SoakFailure, "health not ok" unless health["status"] == "ok"
  raise SoakFailure, "ready not ready" unless ready["status"] == "ready"

  puts "PASS health/readiness/migrations"
end

def stop_service
  compose!("compose cleanup #{PROJECT}", "down", "--remove-orphans", "-v", timeout: 120)
rescue SoakFailure => error
  warn "WARN cleanup failed for #{PROJECT}: #{error.message}"
end

def wait_ready
  deadline = Time.now + 90
  loop do
    begin
      return if fetch_json("#{HOST}/ready")["status"] == "ready"
    rescue StandardError
      nil
    end
    raise SoakFailure, "service did not become ready" if Time.now >= deadline
    sleep 1
  end
end

def fetch_json(url)
  uri = URI(url)
  response = Net::HTTP.get_response(uri)
  raise SoakFailure, "#{url} returned HTTP #{response.code}" unless response.is_a?(Net::HTTPSuccess)

  JSON.parse(response.body)
end

def api_json(method, path, payload: nil, token: nil)
  uri = URI("#{HOST}#{path}")
  request = case method
            when "GET" then Net::HTTP::Get.new(uri)
            when "POST" then Net::HTTP::Post.new(uri)
            else raise SoakFailure, "unsupported HTTP method #{method}"
            end
  request["Accept"] = "application/json"
  request["Authorization"] = "Bearer #{token}" if token
  if payload
    request["Content-Type"] = "application/json"
    request.body = JSON.generate(payload)
  end

  response = Net::HTTP.start(uri.host, uri.port) { |http| http.request(request) }
  raise SoakFailure, "#{method} #{path} returned HTTP #{response.code}" unless response.is_a?(Net::HTTPSuccess)

  JSON.parse(response.body)
end

def checker(action, *args, flags: [], expect_ok: true)
  stdout, stderr, status = capture(
    [PYTHON, "checkers/voltax/checker.py", action, HOST, *args],
    chdir: ADMIN_ROOT,
    env: common_env("VOLTAX_CHECKER_POLICY" => "competition")
  )
  output = [stdout, stderr].join("\n")
  if expect_ok && status.exitstatus != 101
    warn redact(output, flags)[0, 4000]
    raise SoakFailure, "checker #{action} failed with #{status.exitstatus}"
  end
  [stdout.strip, stderr.strip, status.exitstatus]
end

def checker_ok(action, *args, flags: [])
  stdout, stderr, status = checker(action, *args, flags: flags)
  raise SoakFailure, "checker #{action} did not return OK" unless status == 101

  puts "PASS checker #{action}"
  [stdout, stderr]
end

def checker_put(place, flag)
  stdout, stderr = checker_ok("PUT", "incoming-#{SecureRandom.hex(8)}", flag, place.to_s, flags: [flag])
  public = JSON.parse(stdout)
  raise SoakFailure, "checker PUT stdout must be a public JSON object" unless public.is_a?(Hash)
  raise SoakFailure, "checker PUT stdout must not contain flag_id" if public.key?("flag_id")
  private_flag_id = stderr.to_s
  raise SoakFailure, "checker PUT stderr private flag_id missing" if private_flag_id.empty?
  validate_public_attack_data!(public, flag)
  puts "PASS attack data place #{place}: keys=#{public.keys.sort.join(',')}"
  { "flag_id" => private_flag_id, "public" => public }
end

def checker_get(place, flag_id, flag)
  checker_ok("GET", flag_id, flag, place.to_s, flags: [flag, flag_id])
end

def validate_public_attack_data!(value, flag)
  case value
  when Hash
    value.each do |key, child|
      raise SoakFailure, "public attack data contains forbidden key #{key}" if FORBIDDEN_PUBLIC_KEYS.include?(key.to_s.downcase)

      validate_public_attack_data!(child, flag)
    end
  when Array
    value.each { |child| validate_public_attack_data!(child, flag) }
  when String
    raise SoakFailure, "flag sampleed in public attack data" if value.include?(flag)
  end
end

def public_feed(market_symbol: "VOLT-USDT", since_sequence: 0, limit: 100)
  query = URI.encode_www_form(market: market_symbol, since_sequence: since_sequence, limit: limit)
  api_json("GET", "/api/feed/public?#{query}")
end

def run_worker_tick(round)
  compose!(
    "round #{round} matching-engine one-shot",
    "run", "--rm", "matching-engine",
    "matching-engine", "once",
    print_output: true,
    timeout: 180
  )
  compose!(
    "round #{round} market-simulator one-shot",
    "run", "--rm",
    "-e", "VOLTAX_SIMULATOR_TICK=#{round}",
    "market-simulator",
    "market-simulator", "once",
    print_output: true,
    timeout: 180
  )
end

def run_round(round, stored)
  checker_ok("check")
  checker_ok("havoc")
  noisy_place2_roundtrip(round)
  run_worker_tick(round)
  stored.each do |place, row|
    checker_get(place, row.fetch(:flag_id), row.fetch(:flag))
  end
  feed = public_feed(since_sequence: 0, limit: 10)
  assert_feed_sequences_monotonic(feed.fetch("events"))
  puts "PASS round #{round}/#{ROUNDS} checker/workers/feed/intermediate GET"
end

def setup_all_places(prefix)
  (1..4).each_with_object({}) do |place, memo|
    flag = "#{prefix}-PLACE#{place}-#{SecureRandom.hex(8)}"
    payload = checker_put(place, flag)
    checker_get(place, payload.fetch("flag_id"), flag)
    memo[place] = { flag: flag, flag_id: payload.fetch("flag_id"), public: payload.fetch("public") }
  end
end

def noisy_place2_roundtrip(round)
  add_trade_noise("w18c-noise-#{round}")
  flag = "W18C-NOISY-P2-#{round}-#{SecureRandom.hex(8)}"
  payload = checker_put(2, flag)
  checker_get(2, payload.fetch("flag_id"), flag)
  puts "PASS noisy place-2 receipt owner GET round #{round}"
end

def add_trade_noise(label)
  seller = funded_user("#{label}-seller")
  buyer = funded_user("#{label}-buyer")
  price = "88.#{SecureRandom.random_number(9)}"
  quantity = "1.0000"
  create_order(seller, side: "sell", price: price, quantity: quantity, client_order_id: "#{label}-sell")
  create_order(buyer, side: "buy", price: price, quantity: quantity, client_order_id: "#{label}-buy")
end

def rapid_trade_sequence_regression
  threads = 6.times.map do |index|
    Thread.new do
      add_trade_noise("w18c-rapid-#{index}-#{SecureRandom.hex(3)}")
    end
  end
  threads.each(&:value)

  output = internal_sql(<<~SQL)
    select count(*)::text || ',' ||
           count(distinct public_sequence)::text || ',' ||
           count(public_sequence)::text || ',' ||
           coalesce(bool_and(public_sequence > 0), true)::text || ',' ||
           coalesce(bool_and(next_sequence > public_sequence), true)::text
    from (
      select public_sequence,
             lead(public_sequence) over (order by public_sequence) as next_sequence
      from trades
    ) ordered;
  SQL
  count, distinct_count, non_null_count, positive, increasing = output.strip.split(",", 5)
  unless count == distinct_count && count == non_null_count && truthy_sql?(positive) && truthy_sql?(increasing)
    raise SoakFailure, "trade public_sequence regression failed: #{output.strip}"
  end
  puts "PASS rapid trade public_sequence uniqueness/monotonicity: trades=#{count}"
end

def truthy_sql?(value)
  %w[t true].include?(value.to_s.strip.downcase)
end

def internal_sql(sql)
  stdout, = compose!(
    "internal postgres public_sequence query",
    "exec", "-T", "postgres",
    "psql", "-U", "voltax", "-d", "voltax_development", "-tA", "-c", sql,
    timeout: 60
  )
  stdout
end

def ex5_freshness_regression
  flag = "W18C-EX5-FRESH-#{SecureRandom.hex(8)}"
  payload = checker_put(4, flag)
  attack_data = payload.fetch("public")
  since_sequence = Integer(attack_data.fetch("since_sequence").to_s, 10)
  argv = [PYTHON, "sploits/voltax/ex_conditional_feed.py", HOST, JSON.generate("public" => attack_data)]
  stdout, stderr, status = capture(argv, chdir: ADMIN_ROOT, timeout: 30)
  status_code = status.exitstatus

  unless status_code.zero? && stdout.strip == flag
    warn redact("#{stdout}\n#{stderr}", [flag])[0, 4000]
    raise SoakFailure, "EX-5 autonomous freshness exploit did not recover target flag from worker loop"
  end
  after = public_feed(since_sequence: since_sequence, limit: 100)
  assert_feed_sequences_monotonic(after.fetch("events"))
  puts "PASS EX-5 since_sequence freshness exploit path without manual worker intervention"
end

