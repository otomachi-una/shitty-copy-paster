def main
  raise SoakFailure, "W18C_ROUNDS must be at least 7" if ROUNDS < 7

  write_compose_override
  puts "INFO W18-C target host #{HOST}"
  puts "INFO W18-C compose project #{PROJECT}"
  service_fingerprint, service_file_count = scoped_tree_fingerprint(SERVICE_ROOT, SERVICE_TREE_FINGERPRINT_PATHS)
  admin_fingerprint, admin_file_count = scoped_tree_fingerprint(ADMIN_ROOT, ADMIN_TREE_FINGERPRINT_PATHS)
  puts "INFO W18-C service root #{SERVICE_ROOT}"
  puts "INFO W18-C admin root #{ADMIN_ROOT}"
  puts "INFO W18-C service scoped tree fingerprint sha256=#{service_fingerprint} files=#{service_file_count}"
  puts "INFO W18-C admin scoped tree fingerprint sha256=#{admin_fingerprint} files=#{admin_file_count}"
  run_static_preflight
  docker_version = ensure_docker_daemon!
  puts "PASS docker daemon available: server=#{docker_version}"

  start_service
  worker_lifecycle_smoke
  stored = setup_all_places("W18C-SETUP")
  ex5_freshness_regression
  rapid_trade_sequence_regression
  (1..ROUNDS).each do |round|
    run_round(round, stored)
    restart_service if round == (ROUNDS / 2)
  end
  final_gets(stored)
  puts "Wave 18 retention stability soak passed"
rescue SoakFailure => error
  warn "Wave 18 retention stability soak failed: #{error.message}"
  exit 1
ensure
  stop_service if $compose_touched
end

if ARGV.include?("--help")
  puts "usage: ruby bin/run-retention-soak"
  puts
  puts "Environment:"
  puts "  W18C_SERVICE_ROOT=/path/to/voltax-exchange-team"
