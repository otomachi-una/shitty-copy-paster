def redact(text, flags = [])
  redacted = text.to_s.gsub(CHECKER_SECRET, "[checker-credential]")
  redacted = redacted.gsub(SECRET_KEY_BASE, "[credential-key-base]")
  redacted = redacted.gsub(POSTGRES_PASSWORD, "[postgres-password]")
  flags.each { |flag| redacted = redacted.gsub(flag.to_s, "[flag]") }
  redacted.gsub(/Bearer [A-Za-z0-9_\-]+=*/, "Bearer [token]")
end

def run!(label, argv, chdir: ROOT, env: {}, flags: [], success_codes: [0], print_output: false, timeout: nil)
  stdout, stderr, status = capture(argv, chdir: chdir, env: env, timeout: timeout)
  output = [stdout, stderr].reject(&:empty?).join("\n")
  unless success_codes.include?(status.exitstatus)
    warn "FAIL #{label}"
    warn redact(output, flags)[0, 4000]
    raise SoakFailure, "#{label} exited #{status.exitstatus}"
  end
  puts "PASS #{label}"
  puts redact(output, flags) if print_output && !output.empty?
  [stdout, stderr, status.exitstatus]
end

def capture(argv, chdir: ROOT, env: {}, timeout: nil)
  return Open3.capture3(env, *argv, chdir: chdir) unless timeout

  stdout = +""
  stderr = +""
  status = nil
  Open3.popen3(env, *argv, chdir: chdir) do |stdin, out, err, wait_thread|
    stdin.close
    unless wait_thread.join(timeout)
      Process.kill("KILL", wait_thread.pid)
      wait_thread.join(2)
      raise SoakFailure, "BLOCKED_ENV #{argv.join(' ')} timed out after #{timeout}s"
    end
    stdout = out.read
    stderr = err.read
    status = wait_thread.value
  end
  [stdout, stderr, status]
end

